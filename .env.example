# BitMEX 서브계정 API (Withdraw 권한 없이 발급)
BITMEX_API_KEY=your_subaccount_key_here
BITMEX_SECRET=your_subaccount_secret_here

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here

# 리스크 파라미터
RISK_PER_TRADE=0.02        # 잔고의 2%
STOP_LOSS_PCT=0.015        # ±1.5% 손절
MAX_DAILY_LOSS_PCT=0.05    # 5% 손실 시 봇 자동 중단
TRADE_SYMBOL=BTC/USDT:USDT

# FastAPI
API_PORT=8000
BOT_SECRET=random_secret_for_dashboard_auth
